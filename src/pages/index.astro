---
import LaunchLayout from '../layouts/LaunchLayout.astro';
import { siteConfig, coordsShort } from '../config';

const c = siteConfig;

// ── status → visual ──
const statusMap: Record<string, { label: string; color: string }> = {
  live:     { label: 'LIVE',     color: 'var(--color-warm)' },
  beta:     { label: 'BETA',     color: 'var(--color-tertiary)' },
  building: { label: 'BUILDING', color: 'var(--color-accent)' },
  docked:   { label: 'DOCKED',   color: 'var(--color-faint)' },
};

// ── accent key → css var ──
const accentVar: Record<string, string> = {
  accent: 'var(--color-accent)',
  warm: 'var(--color-warm)',
  tertiary: 'var(--color-tertiary)',
};

// ── icon map (inner markup for a 24×24 stroke SVG) ──
const icons: Record<string, string> = {
  prompt:  '<path d="M4 17l6-5-6-5M12 19h8"/>',
  bolt:    '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  compass: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  book:    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>',
  globe:   '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
};

// deterministic bearing per vessel
const bearing = (i: number) => String((i * 47 + 42) % 360).padStart(3, '0') + '°';
---

<LaunchLayout title={`${c.name.full} — ${c.launch.title}`} description={c.launch.tagline}>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `${c.name.full} — ${c.launch.title}`,
    "itemListElement": c.sites.map((s, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": s.url,
      "name": s.name,
      "description": s.tagline,
    })),
  })} />

  <!-- ══════ HERO ══════ -->
  <section class="relative max-w-4xl mx-auto px-6 md:px-10 pt-28 md:pt-32 pb-12">

    <!-- Brand -->
    <a href="/navigator" aria-label="Meet the navigator" class="hero-fade group/brand inline-flex items-center gap-3 mb-14 w-fit">
      <div class="w-9 h-9 relative flex items-center justify-center flex-shrink-0">
        <div class="absolute inset-0 rounded-full border border-dashed border-[var(--color-accent)]/40 group-hover/brand:border-[var(--color-accent)] transition-colors animate-[spin_30s_linear_infinite]"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] relative z-10"></div>
        <span class="absolute top-[3px] left-1/2 -translate-x-1/2 text-[6px] font-mono font-bold text-[var(--color-warm)]">N</span>
      </div>
      <div class="flex flex-col -space-y-0.5">
        <span class="text-sm font-semibold font-[family-name:var(--font-display)] text-[var(--color-text)] group-hover/brand:text-[var(--color-accent)] transition-colors">{c.name.short}</span>
        <span class="text-[8px] font-mono faint tracking-[0.15em]">{coordsShort}</span>
      </div>
    </a>

    <!-- Eyebrow -->
    <div class="hero-fade flex items-center gap-2.5 mb-6">
      <span class="relative flex items-center justify-center w-2 h-2">
        <span class="absolute inset-0 rounded-full bg-[var(--color-accent)] animate-ping opacity-30"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
      </span>
      <span class="section-label">{c.launch.eyebrow}</span>
    </div>

    <!-- Title -->
    <h1 class="mb-6">
      <span class="block overflow-hidden pb-1">
        <span class="line-reveal hero-title block text-[clamp(2.75rem,10vw,6.5rem)]">
          {c.launch.title}<span class="accent-warm">.</span>
        </span>
      </span>
    </h1>

    <!-- Tagline -->
    <p class="hero-fade max-w-md text-base md:text-lg dim leading-relaxed">
      {c.launch.tagline}
    </p>

    <!-- Fleet count readout -->
    <div class="hero-fade flex items-center gap-3 mt-8 text-[10px] font-mono faint tracking-[0.15em]">
      <span>{String(c.sites.length).padStart(2, '0')} VESSELS IN HARBOUR</span>
      <span class="flex-1 max-w-[120px] border-t border-dashed border-[var(--color-edge)]"></span>
    </div>
  </section>

  <!-- ══════ FLEET GRID ══════ -->
  <section class="max-w-4xl mx-auto px-6 md:px-10 pb-24">
    <div class="stagger grid sm:grid-cols-2 gap-5">
      {c.sites.map((site, i) => {
        const s = statusMap[site.status] ?? statusMap.live;
        const a = accentVar[site.accent] ?? accentVar.accent;
        return (
          <a
            href={site.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card card-coord tilt group block p-7"
            style={`transform-style:preserve-3d`}
          >
            {/* Top row: icon + status */}
            <div class="flex items-start justify-between mb-9">
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center border transition-colors duration-300"
                style={`background: color-mix(in srgb, ${a} 10%, transparent); border-color: color-mix(in srgb, ${a} 30%, transparent); color: ${a};`}
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[site.icon] ?? icons.globe} />
              </div>
              <div class="flex items-center gap-2">
                <span class="relative flex items-center justify-center w-2 h-2">
                  <span class="absolute inset-0 rounded-full animate-ping opacity-40" style={`background:${s.color}`}></span>
                  <span class="w-1.5 h-1.5 rounded-full" style={`background:${s.color}`}></span>
                </span>
                <span class="text-[9px] font-mono tracking-[0.15em]" style={`color:${s.color}`}>{s.label}</span>
              </div>
            </div>

            {/* Callsign + bearing */}
            <div class="flex items-center gap-2 mb-3">
              <span class="text-[9px] font-mono faint tracking-[0.2em]">VESSEL {String(i + 1).padStart(2, '0')}</span>
              <span class="w-4 border-t border-dashed border-[var(--color-faint)]/30"></span>
              <span class="bearing-badge">{bearing(i)}</span>
            </div>

            {/* Name */}
            <h2 class="font-[family-name:var(--font-display)] text-2xl md:text-[1.75rem] font-bold text-[var(--color-text)] leading-tight mb-2.5 transition-colors group-hover:text-[var(--color-accent)]">
              {site.name}
            </h2>

            {/* Tagline */}
            <p class="text-sm dim leading-relaxed mb-8">{site.tagline}</p>

            {/* Host + launch */}
            <div class="flex items-center justify-between pt-4 border-t border-dashed border-[var(--color-edge)]">
              <span class="text-[11px] font-mono faint tracking-wide truncate">{site.host}</span>
              <span class="inline-flex items-center gap-1.5 text-[11px] font-mono accent flex-shrink-0 ml-3">
                Launch
                <svg class="w-3.5 h-3.5 -rotate-45 transition-transform duration-300 group-hover:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Portfolio link -->
    <div class="reveal mt-14 flex items-center justify-between gap-4 flex-wrap">
      <a href="/navigator" class="magnetic group inline-flex items-center gap-2.5 text-sm dim hover:text-[var(--color-accent)] transition-colors">
        <span class="w-7 h-7 rounded-full border border-[var(--color-edge)] flex items-center justify-center group-hover:border-[var(--color-accent)]/40 transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        </span>
        <span class="font-mono text-[13px]">Meet the navigator</span>
      </a>
      <span class="text-[10px] font-mono faint tracking-wider">&copy; {new Date().getFullYear()} {c.name.full}</span>
    </div>
  </section>

</LaunchLayout>
